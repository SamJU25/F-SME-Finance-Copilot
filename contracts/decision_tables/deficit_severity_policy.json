{
  "nodes": [
    {
      "id": "input_node",
      "name": "DeficitSeverityRequest",
      "type": "inputNode"
    },
    {
      "id": "table_node",
      "name": "DeficitSeverityPolicyTable",
      "type": "decisionTableNode",
      "content": {
        "hitPolicy": "first",
        "inputs": [
          {
            "id": "in_has",
            "field": "has_deficit",
            "name": "Has Deficit"
          },
          {
            "id": "in_days",
            "field": "days_until_deficit",
            "name": "Days Until Deficit"
          }
        ],
        "outputs": [
          {
            "id": "out_sev",
            "field": "severity",
            "name": "Deficit Severity Horizon"
          },
          {
            "id": "out_has_proj",
            "field": "has_projected_deficit",
            "name": "Has Projected Deficit"
          },
          {
            "id": "out_template",
            "field": "explanation_template",
            "name": "Deficit Explanation Narrative Template"
          }
        ],
        "rules": [
          {
            "_id": "rule_safe",
            "_description": "No projected cash deficit across evaluated horizon",
            "in_has": "false",
            "in_days": "",
            "out_sev": "'SAFE'",
            "out_has_proj": "false",
            "out_template": "'HEALTHY LIQUIDITY: Operations solvent across all 90-day forecast windows. Projected 90-day reserve: ${d90}.'"
          },
          {
            "_id": "rule_critical",
            "_description": "Deficit within 30 days is Critical emergency",
            "in_has": "true",
            "in_days": "<= 30",
            "out_sev": "'CRITICAL'",
            "out_has_proj": "true",
            "out_template": "'CRITICAL EARLY WARNING: Projected cash deficit in {days} days ({date}){trigger}. Estimated shortfall is ${shortfall}. Pre-emptive working capital draw of ${bridge} is recommended to prevent operational stoppage.'"
          },
          {
            "_id": "rule_warning",
            "_description": "Deficit within 31 to 60 days is Warning horizon",
            "in_has": "true",
            "in_days": "<= 60",
            "out_sev": "'WARNING'",
            "out_has_proj": "true",
            "out_template": "'ELEVATED DEFICIT RISK: Cash burn trajectory indicates a shortfall in {days} days ({date}){trigger}. Projected deficit of ${shortfall} requires liquidity action within 30 days.'"
          },
          {
            "_id": "rule_watch",
            "_description": "Deficit beyond 60 days is Watch horizon",
            "in_has": "true",
            "in_days": "> 60",
            "out_sev": "'WATCH'",
            "out_has_proj": "true",
            "out_template": "'EXTENDED WATCH: Operations remain solvent for 60+ days, with projected deficit in {days} days{trigger}. Monitor incoming receivables and accounts payable timing.'"
          },
          {
            "_id": "rule_fallback",
            "_description": "Fallback rule default to Safe",
            "in_has": "",
            "in_days": "",
            "out_sev": "'SAFE'",
            "out_has_proj": "false",
            "out_template": "'HEALTHY LIQUIDITY: Operations solvent across all 90-day forecast windows.'"
          }
        ]
      }
    },
    {
      "id": "output_node",
      "name": "DeficitSeverityResponse",
      "type": "outputNode"
    }
  ],
  "edges": [
    {
      "id": "edge_in_to_table",
      "sourceId": "input_node",
      "targetId": "table_node"
    },
    {
      "id": "edge_table_to_out",
      "sourceId": "table_node",
      "targetId": "output_node"
    }
  ]
}
