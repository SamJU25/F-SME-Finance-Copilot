{
  "prompt_security_patterns": {
    "injection_regex": "(ignore|disregard|forget|override)\\s+(all\\s+)?(?:previous|prior|above)?\\s*(?:instructions|prompts|rules|guidelines|security)|system\\s+override|god\\s+mode|jailbreak|you\\s+are\\s+now\\s+(?:an?\\s+)?unrestricted|bypass\\s+(?:2fa|biometric|security|hitl|tier)|admin\\s+mode\\s+enabled",
    "credential_regex": "\\b(?:sk-ant-[a-zA-Z0-9_\\-]{20,}|sk-[a-zA-Z0-9_\\-]{20,}|AIzaSy[a-zA-Z0-9_\\-]{30,}|gsk_[a-zA-Z0-9_\\-]{20,})\\b|(?:api[_-]?key|secret[_-]?token|bearer[_-]?token|password|pin|routing[_-]?number)\\s*[:=]\\s*['\"]?([a-zA-Z0-9_\\-]{4,})['\"]?"
  },
  "staging_defaults": {
    "default_action_type": "DRAW_CREDIT_LINE",
    "default_amount_cents": 2500000,
    "default_target_identifier": "SME-LIQUIDITY-FACILITY"
  },
  "nodes": [
    {
      "id": "input_node",
      "name": "SecurityGateRequest",
      "type": "inputNode"
    },
    {
      "id": "table_node",
      "name": "SecurityGatePolicyTable",
      "type": "decisionTableNode",
      "content": {
        "hitPolicy": "first",
        "inputs": [
          {
            "id": "in_act",
            "field": "action_type",
            "name": "Action Type"
          }
        ],
        "outputs": [
          {
            "id": "out_tier",
            "field": "security_tier",
            "name": "Security Tier"
          },
          {
            "id": "out_bio",
            "field": "requires_biometric_execution",
            "name": "Requires WebAuthn Biometric HITL"
          }
        ],
        "rules": [
          {
            "_id": "rule_tier_3",
            "_description": "Irreversible financial disbursements require strict Tier 3 biometric authorization",
            "in_act": "'TRANSFER', 'DRAW_CREDIT_LINE', 'PLEDGE_INVOICE'",
            "out_tier": "'TIER_3_EXECUTION'",
            "out_bio": "true"
          },
          {
            "_id": "rule_tier_2",
            "_description": "Staging intent into audit ledger without fund movement",
            "in_act": "'STAGE_TRANSFER', 'FACTOR_INVOICE', 'PREPARE_APPLICATION'",
            "out_tier": "'TIER_2_STAGING'",
            "out_bio": "false"
          },
          {
            "_id": "rule_tier_1",
            "_description": "Autonomous read-only observations and ledger queries",
            "in_act": "",
            "out_tier": "'TIER_1_OBSERVATION'",
            "out_bio": "false"
          }
        ]
      }
    },
    {
      "id": "output_node",
      "name": "SecurityGateResponse",
      "type": "outputNode"
    }
  ],
  "edges": [
    {
      "id": "edge_in_to_table",
      "sourceId": "input_node",
      "targetId": "table_node"
    },
    {
      "id": "edge_table_to_out",
      "sourceId": "table_node",
      "targetId": "output_node"
    }
  ]
}
