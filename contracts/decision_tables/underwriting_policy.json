{
  "nodes": [
    {
      "id": "input_node",
      "name": "UnderwritingRequest",
      "type": "inputNode"
    },
    {
      "id": "table_node",
      "name": "UnderwritingPolicyTable",
      "type": "decisionTableNode",
      "content": {
        "hitPolicy": "first",
        "inputs": [
          {
            "id": "in_dab",
            "field": "dab",
            "name": "Daily Average Balance"
          },
          {
            "id": "in_nsf",
            "field": "nsf_count",
            "name": "NSF Count"
          }
        ],
        "outputs": [
          {
            "id": "out_tier",
            "field": "risk_tier",
            "name": "Risk Tier"
          },
          {
            "id": "out_mult",
            "field": "limit_multiplier",
            "name": "Credit Limit Multiplier"
          },
          {
            "id": "out_products",
            "field": "recommended_product_types",
            "name": "Eligible Financial Products"
          }
        ],
        "rules": [
          {
            "_id": "rule_prime",
            "_description": "Prime Tier: DAB >= 10,000 and 0 NSF incidents",
            "in_dab": ">= 10000",
            "in_nsf": "== 0",
            "out_tier": "'PRIME'",
            "out_mult": "'3.0'",
            "out_products": "['WORKING_CAPITAL_LINE', 'INVOICE_FACTORING', 'REVENUE_BASED_FINANCING']"
          },
          {
            "_id": "rule_near_prime",
            "_description": "Near Prime: DAB >= 3,000 and <= 1 NSF incident",
            "in_dab": ">= 3000",
            "in_nsf": "<= 1",
            "out_tier": "'NEAR_PRIME'",
            "out_mult": "'1.5'",
            "out_products": "['INVOICE_FACTORING', 'REVENUE_BASED_FINANCING']"
          },
          {
            "_id": "rule_high_risk",
            "_description": "High Risk: Sub-3,000 DAB or multiple NSF incidents",
            "in_dab": "",
            "in_nsf": "",
            "out_tier": "'HIGH_RISK'",
            "out_mult": "'0.5'",
            "out_products": "['INVOICE_FACTORING']"
          }
        ]
      }
    },
    {
      "id": "output_node",
      "name": "UnderwritingResponse",
      "type": "outputNode"
    }
  ],
  "edges": [
    {
      "id": "edge_in_to_table",
      "sourceId": "input_node",
      "targetId": "table_node"
    },
    {
      "id": "edge_table_to_out",
      "sourceId": "table_node",
      "targetId": "output_node"
    }
  ]
}
